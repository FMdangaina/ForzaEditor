*~

# Local working copies (not part of the source)
_backup_originali/
bak/

# Game assets: never commit copyrighted Forza data
*.zip
*.carbin
*.xds
*.bix
*.xpr
*.gr2
*.tga
*.slt
*.str
\!FH demo car*/
\!FM4 demo car*/

# Third-party tools: only MIT-licensed ones are committed (see THIRD-PARTY-NOTICES.md).
# Xbox 360 SDK files (xdevkit, xcompress) and xds.dll stay local.
/\!ForzaStudio release/*
!/\!ForzaStudio release/Be.Windows.Forms.HexBox.dll
!/\!ForzaStudio release/texconv.exe

# Runtime files written next to the exe
settings.txt
materials.txt
